{
  "name": "envoi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p clients/typescript/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "operator": "tsx src/operator/cli.ts",
    "runner:build": "tsc -p tsconfig.runner.json",
    "runner:start": "node --import ./.maintenance-build/src/maintenance/resolve-hook.js ./.maintenance-build/src/maintenance/run.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.86",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@neon/config": "^1.8.4",
    "@neon/env": "^1.5.1",
    "@solana-program/memo": "0.15.0",
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.4.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@wallet-standard/app": "1.1.1",
    "ai": "7.0.130",
    "barcode-detector": "3.2.2",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@solana/sysvars": "8.4.0"
  }
}
