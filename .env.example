# Names only, never values. Real values live in the ignored .env.local and in Render.
# Must list exactly the names src/env.ts reads.

# Web (Render and local dev)
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
APP_BASE_URL=
ENVOI_ENVIRONMENT=
LOG_LEVEL=

# PayPal sandbox REST app and the payments kill switch (Render and local dev)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_WEBHOOK_ID=
PAYMENTS_ENABLED=
# Comma-separated seller merchant ids that may take crypto through PayPal; empty means off
PAYPAL_CRYPTO_ENABLED=

# Buyer text suggestions (Render and local dev); leave both unset for manual selection only
OPENAI_API_KEY=
AI_MODEL=

# Ask Envoi in the site (Render and local dev); off unless this, OPENAI_API_KEY and AI_MODEL are set.
# An agent token from npm run operator -- issue-agent-token <label>, server only.
ASSISTANT_AGENT_TOKEN=

# Merchant copilot (Render and local dev): one labeled sandbox seller's own REST app. The copilot runs
# only for the outlet whose PayPal seller is PAYPAL_DEMO_SELLER_MERCHANT_ID, and is off unless all
# three, OPENAI_API_KEY and AI_MODEL are set. Refunds of that seller's captures use these credentials.
PAYPAL_DEMO_SELLER_CLIENT_ID=
PAYPAL_DEMO_SELLER_CLIENT_SECRET=
PAYPAL_DEMO_SELLER_MERCHANT_ID=

# Stall demand (Render and local dev): the key for the keyed hash of an unenrolled sticker, at least
# 32 characters, for example from openssl rand -hex 32. Unset means no scan is counted.
STICKER_HASH_KEY=

# Menu photo import (Render and local dev); imports stay closed unless MENU_IMPORTS_ENABLED is "true"
# and AI_MENU_MODEL has a reviewed bounds entry. It also needs OPENAI_API_KEY above.
AI_MENU_MODEL=
MENU_IMPORTS_ENABLED=

# Web menu import (Render and local dev); closed unless WEB_IMPORTS_ENABLED is "true" and
# AI_WEB_MENU_MODEL has a reviewed bounds entry. It also needs OPENAI_API_KEY above.
KERNEL_API_KEY=
AI_WEB_MENU_MODEL=
WEB_IMPORTS_ENABLED=

# The menu explained and translated (Render and local dev); off unless this and OPENAI_API_KEY are set.
AI_MENU_TRANSLATION_MODEL=

# Tourist-ready Workflow (Render only): the web service starts one Render flow run after a publish.
# Both unset means no run is started. The key is server only and never committed.
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=

# Merchant sign-up (Render and local dev): strangers may create an account and one pending test shop
# only while this is "true". An Envoi admin still approves every shop.
MERCHANT_SIGNUP_ENABLED=

# PYUSD on Solana devnet (Render and local dev); the rail stays off unless PYUSD_ENABLED is "true".
# The cluster, mint and programs are reviewed code constants, never settings.
SOLANA_RPC_URL=
PYUSD_ENABLED=

# Migrations and operator commands (local only, never on Render)
MIGRATION_DATABASE_URL=

# Maintenance runner (manual local runs and the scheduled maintenance.yml; never on Render). It also
# reads ENVOI_ENVIRONMENT, LOG_LEVEL, the three PayPal names above for order reads only and
# SOLANA_RPC_URL above for devnet reads only.
MAINTENANCE_DATABASE_URL=

# Integration tests (disposable local PostgreSQL or the CI service container, never Neon)
TEST_DATABASE_URL=
